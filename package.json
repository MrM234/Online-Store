{
  "name": "electronics-shop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "install-all": "npm install && cd shop && npm install",
    "json-server": "json-server --watch db.json --port 3000",
    "shop:dev": "cd shop && npm run dev",
    "start": "npm-run-all --parallel json-server shop:dev"
  },
  "devDependencies": {
    "json-server": "^0.17.3",
    "npm-run-all": "^4.1.5"
  },
  "dependencies": {
    "framer-motion": "^12.40.0"
  }
}
